<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- favicon -->
    <link
      rel="icon"
      type="image/png"
      href="<%= process.env.SITE_URL %>/media/favicon/favicon-96x96.png"
      sizes="96x96"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="<%= process.env.SITE_URL %>/media/favicon/favicon.svg"
    />
    <link
      rel="shortcut icon"
      href="<%= process.env.SITE_URL %>/media/favicon/favicon.ico"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="<%= process.env.SITE_URL %>/media/favicon/apple-touch-icon.png"
    />
    <meta name="apple-mobile-web-app-title" content="Skill-Share" />
    <!-- style -->
    <link
      rel="stylesheet"
      href="<%= process.env.SITE_URL %>/assets/styles/styles.css"
    />
    <% if (title === "Inscription") { %>
    <link
      rel="stylesheet"
      href="<%= process.env.SITE_URL %>/assets/styles/form/form.css"
    />
    <% } %> <% if (title === "Vérification email") { %>
    <link
      rel="stylesheet"
      href="<%= process.env.SITE_URL %>/assets/styles/verify-email/verify-email.css"
    />
    <% } %>
    <!-- polices -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Erica+One&display=swap"
      rel="stylesheet"
    />
    <style>
      @font-face {
        font-family: "TheFont";
        src: url("https://garet.typeforward.com/assets/fonts/shared/TFMixVF.woff2")
          format("woff2");
      }
    </style>
    <!-- titre -->
    <title><%= title || "Skill-Share" %></title>
  </head>
  <body>
    <header><%- include("./components/navbar") %></header>

    <main>
      <h1 id="title" class="background-title"><%= title %></h1>
      <div class="content"><%- include(view) %></div>
    </main>

    <script
      type="module"
      src="<%= process.env.SITE_URL %>/assets/js/navbar.js"
    ></script>
    <script
      type="module"
      src="<%= process.env.SITE_URL %>/assets/js/h1.js"
    ></script>
    <% if (title === "Inscription") { %>
    <script
      type="module"
      src="<%= process.env.SITE_URL %>/assets/js/register.js"
    ></script>
    <% } %> <% if (title === "Vérification email") { %>
    <script
      type="module"
      src="<%= process.env.SITE_URL %>/assets/js/verify-email.js"
    ></script>
    <% } %>
  </body>
</html>
