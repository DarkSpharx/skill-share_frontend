<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- favicon -->
    <link
      rel="icon"
      type="image/png"
      href="<%= process.env.SITE_URL %>/media/favicon/favicon-96x96.png"
      sizes="96x96"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="<%= process.env.SITE_URL %>/media/favicon/favicon.svg"
    />
    <link
      rel="shortcut icon"
      href="<%= process.env.SITE_URL %>/media/favicon/favicon.ico"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="<%= process.env.SITE_URL %>/media/favicon/apple-touch-icon.png"
    />
    <meta name="apple-mobile-web-app-title" content="Skill-Share" />
    <!-- style principale -->
    <link
      rel="stylesheet"
      href="<%= process.env.SITE_URL %>/assets/styles/styles.css"
    />
    <!-- styles spécifiques pour le formulaire d'inscription -->
    <% if (title === "Inscription") { %>
    <link
      rel="stylesheet"
      href="<%= process.env.SITE_URL %>/assets/styles/form/form.css"
    />
    <% } %>
    <!-- styles spécifiques pour le formulaire de connexion -->
    <% if (title === "Connexion" || title === "Profil") { %>
    <link
      rel="stylesheet"
      href="<%= process.env.SITE_URL %>/assets/styles/form/form.css"
    />
    <% } %>
    <!-- styles spécifiques pour la vérification email -->
    <% if (title === "Vérification email") { %>
    <link
      rel="stylesheet"
      href="<%= process.env.SITE_URL %>/assets/styles/verify-email/verify-email.css"
    />
    <% } %>
    <!-- styles spécifiques pour la réinitialisation de mot de passe -->
    <% if (title === "Réinitialisation mot de passe") { %>
    <link
      rel="stylesheet"
      href="<%= process.env.SITE_URL %>/assets/styles/reset-password/reset-password.css"
    />
    <% } %>
    <!-- lien Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"
      integrity="sha512-z3gLpd7yknf1YoNbCzqRKc4qyor8gaKU1qmn+CShxbuBusANI9QpRohGBreCFkKxLhei6S9CQXFEbbKuqLg0DA=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />

    <!-- polices -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Erica+One&display=swap"
      rel="stylesheet"
    />
    <style>
      @font-face {
        font-family: "TheFont";
        src: url("https://garet.typeforward.com/assets/fonts/shared/TFMixVF.woff2")
          format("woff2");
      }
    </style>
    <!-- titre -->
    <title><%= title || "Skill-Share" %></title>
  </head>
  <body>
    <header><%- include("./components/navbar") %></header>

    <main>
      <h1 id="title" class="background-title"><%= title %></h1>
      <div class="content"><%- include(view) %></div>
    </main>

    <script
      type="module"
      src="<%= process.env.SITE_URL %>/assets/js/navbar.js"
    ></script>
    <script
      type="module"
      src="<%= process.env.SITE_URL %>/assets/js/h1.js"
    ></script>
    <!-- JS pour la page d'inscription -->
    <% if (title === "Inscription") { %>
    <script
      type="module"
      src="<%= process.env.SITE_URL %>/assets/js/register.js"
    ></script>
    <% } %>
    <!-- JS pour la page de vérification email -->
    <% if (title === "Vérification email") { %>
    <script
      type="module"
      src="<%= process.env.SITE_URL %>/assets/js/verify-email.js"
    ></script>
    <% } %>
    <!-- JS pour la page de connexion -->
    <% if (title === "Connexion") { %>
    <script
      type="module"
      src="<%= process.env.SITE_URL %>/assets/js/login.js"
    ></script>
    <% } %>
    <!-- JS pour la page de réinitialisation de mot de passe -->
    <% if (title === "reset-password") { %>
    <script
      type="module"
      src="<%= process.env.SITE_URL %>/assets/js/reset-password.js"
    ></script>
    <% } %>
    <!-- JS pour la page de Dashboard -->
    <% if (title === "Dashboard") { %>
    <script
      type="module"
      src="<%= process.env.SITE_URL %>/assets/js/dashboard.js"
    ></script>
    <% } %>
    <!-- JS pour la page de Profil -->
    <% if (title === "Profil") { %>
    <script
      type="module"
      src="<%= process.env.SITE_URL %>/assets/js/account.js"
    ></script>
    <% } %>
  </body>
</html>
