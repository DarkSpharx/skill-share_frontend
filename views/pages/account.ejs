    <!-- div bloc n2 de la grid -->
    <div class="form-grid">
      <div class="form-group">
        <div class="profile-card avatar-section">
          <label style="margin-top: 20px">Photo de profil</label>
          <div class="avatar-container" style="text-align: center">
            <img
              id="user-avatar"
              src=""
              alt="Avatar"
              class="avatar"
              style="max-height: 200px"
            />
          </div>
        </div>

        <form id="avatar-form">
          <div class="file-input-wrapper">
            <input
              type="file"
              name="avatar"
              id="avatar-input"
              accept="image/*"
            />
            <button type="submit" class="btn btn-primary">
              Modifier l'avatar
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- div bloc n3 de la grid -->
    <!-- Section Sécurité  -->
    <div class="form-grid">
      <div class="profile-card security">
        <h3>Sécurité</h3>
        <div class="password-reset">
          <p>
            Pour des raisons de sécurité, la modification du mot de passe se
            fait via un lien envoyé par email.
          </p>
          <button id="request-reset-btn" class="btn btn-primary">
            Recevoir un lien de réinitialisation
          </button>
          <div id="reset-msg"></div>
        </div>
      </div>
    </div>
</section>
