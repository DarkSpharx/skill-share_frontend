<section class="account">
  <h2>
    Profil de
    <span id="profile-title"></span>
  </h2>
  <div class="verify-msg" style="text-align: center"></div>
  <form action="" id="info-form">
    <input type="hidden" id="api-url" value="<%= typeof API_URL !== "undefined"
    ? API_URL : "" %>"/>

    <div class="form-grid">
      <div class="form-group">
        <label for="password"> Modifier votre mot de passe </label>
        <a href="/reset-password" class="reset-link">Cliquez-ici</a>
      </div>
      <div class="form-group">
        <label for="username">Mofifier votre nom d'utilisateur</label>
        <input type="text" class="form-control" id="username" name="username" />
        <span class="" data-error="username"></span>
      </div>

      <div class="form-group">
        <label for="email">Modifier votre adresse email</label>
        <input
          type="text"
          autocomplete="username"
          class="form-control"
          id="email"
          name="email"
        />
        <span class="" data-error="email"></span>
      </div>

      <button type="submit" class="btn btn-primary mt-3">Valider</button>
    </div>
  </form>

