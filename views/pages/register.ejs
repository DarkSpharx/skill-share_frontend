<!-- si traitement fichier => enctype="multipart/form-data" -->
<!-- pour le traitement des données dans le JS on utilise new FormData()  -->
<section class="register">
  <form
    method="POST"
    action=""
    enctype="multipart/form-data"
    id="register-form"
  >
    <div class="verify-msg"></div>

    <div class="form-group" style="margin: 25px 0;">
    <p class="mt-3" style="text-align: center; color: #fff;">
      Si vous avez déja un compte 
      <br>
      <a href="/login" style="color: #F9B233; text-transform: uppercase; text-decoration: underline;"">Connectez-vous</a>
    </p>
  </div>

    <input type="hidden" id="api-url" value="<%= typeof API_URL !== "undefined"
    ? API_URL : "" %>"/>

    <div class="form-group">
      <label for="username">Nom d'utilisateur</label>
      <input type="text" class="form-control" id="username" name="username" />
      <span class="" data-error="username"></span>
    </div>

    <div class="form-group">
      <label for="email">Adresse email</label>
      <input
        type="text"
        autocomplete="username"
        class="form-control"
        id="email"
        name="email"
      />
      <span class="" data-error="email"></span>
    </div>

    <div class="form-group">
      <label for="password">Mot de passe</label>
      <input
        type="password"
        autocomplete="current-password"
        class="form-control"
        id="password"
        name="password"
      />
      <span class="" data-error="password"></span>
    </div>

    <!-- <div class="form-group">
      <label for="avatar">Avatar (image JPG/PNG)</label>
      <input
        type="file"
        class="form-control"
        id="avatar"
        name="avatar"
        accept="image/png, image/jpeg"
      />
      <span class="btn-form" data-error="avatar"></span>
    </div> -->

    <div class="form-group">
      <label for="avatar">Avatar (image JPG/PNG)</label>
      <div class="file-input-container" id="fileContainer">
        <input
          type="file"
          class="form-control"
          id="avatar"
          name="avatar"
          accept="image/png, image/jpeg"
        />
        <div class="file-input-content">
          <div class="file-input-icon">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="17,8 12,3 7,8"></polyline>
              <line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
          </div>
          <div class="file-input-text">
            <strong>Click to upload</strong> or drag and drop
          </div>
          <div class="file-input-hint">PNG, JPG, JPEG, Gif up to 2MB</div>
        </div>
        <div class="file-preview" id="filePreview">
          <img id="preview" src="" alt="Preview" />
          <div class="file-info" id="fileInfo"></div>
        </div>
      </div>
      <span class="" data-error="avatar"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-3">S'inscrire</button>
  </form>
</section>
