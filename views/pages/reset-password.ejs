<section class="reset">
  <input
    type="hidden"
    id="api-url"
    value="<%= typeof API_URL !== 'undefined' ? API_URL : '' %>"
  />
  <div class="reset-password-container">
    <form id="reset-password-form" method="POST" action="/">
      <div class="form-group">
        <label for="email">Adresse email</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          autocomplete="username"
        />
      </div>
      <div class="form-group">
        <label for="password">Nouveau mot de passe</label>
        <input
          type="password"
          id="password"
          name="password"
          required
          minlength="12"
        />
      </div>
      <div class="form-group">
        <label for="confirm-password">Confirmer le mot de passe</label>
        <input
          type="password"
          id="confirm-password"
          name="confirm-password"
          required
          minlength="12"
        />
      </div>
      <button type="submit" class="btn-primary">Réinitialiser</button>
    </form>
    <div id="reset-msg"></div>
  </div>
</section>
